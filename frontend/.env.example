# =============================================
# ACOHST Frontend — Environment Variables
# =============================================
# Copy this file to .env and fill in real values
# DO NOT commit .env to version control

# URL of the deployed backend API (set this on Vercel dashboard too)
# In local development, the Vite proxy handles /api — leave this blank or unset
VITE_API_URL=https://acohst-kore.vercel.app/api
